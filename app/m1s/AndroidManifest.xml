<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ghostlock.m1s">

    <!-- Shizuku API 权限(manager 期命名;rikka 现名 moe.shizuku.permission.API_V23 一并声明无害) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="moe.shizuku.permission.API_V23" />

    <!-- Android 11+ 包可见性:找 Shizuku 应用 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:label="m1s"
        android:debuggable="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- Shizuku 客户端 binder 接收点(官方固定写法) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.ghostlock.m1s.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
